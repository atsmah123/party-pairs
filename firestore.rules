rules_version = '2';

// Pairs. Paste this into Firebase console > Firestore Database > Rules.
// Every guest is signed in anonymously; these rules stop one guest from
// editing another guest's card, rewriting pairs, or adding rules for a pair
// they are not part of.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // One card per guest, stored under their own sign-in id.
    match /guests/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 24
        && request.resource.data.emoji is string
        && request.resource.data.emoji.size() <= 16
        && request.resource.data.fact is string
        && request.resource.data.fact.size() <= 140
        && request.resource.data.interests is list
        && request.resource.data.interests.size() <= 10
        && request.resource.data.code is string
        && request.resource.data.code.size() == 4;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // A confirmed pair. Written once by one of the two guests, never changed.
    // The guest who wrote it may delete it (the stress test tidies up this way).
    match /pairs/{pairId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.a is string
        && request.resource.data.b is string
        && request.resource.data.a < request.resource.data.b
        && pairId == request.resource.data.a + '_' + request.resource.data.b
        && request.resource.data.by == request.auth.uid
        && (request.resource.data.a == request.auth.uid || request.resource.data.b == request.auth.uid);
      allow update: if false;
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }

    // One house rule per pair that earned it, written by either of the two.
    match /rules/{pairId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 140
        && request.resource.data.by == request.auth.uid
        && exists(/databases/$(database)/documents/pairs/$(pairId))
        && get(/databases/$(database)/documents/pairs/$(pairId)).data.unlock == true
        && (get(/databases/$(database)/documents/pairs/$(pairId)).data.a == request.auth.uid
            || get(/databases/$(database)/documents/pairs/$(pairId)).data.b == request.auth.uid);
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }
  }
}
